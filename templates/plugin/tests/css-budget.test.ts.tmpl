import { describe, test, expect } from 'bun:test';
import path from 'node:path';
import fs from 'node:fs';
import stylelint from 'stylelint';

const root = path.resolve( import.meta.dir, '..' );
const configFile = path.join( root, '.stylelintrc' );
const config = JSON.parse( fs.readFileSync( configFile, 'utf8' ) ) as Record<string, unknown>;

async function lint( code: string ) {
	return stylelint.lint( { code, config, configBasedir: root } );
}

describe( 'stylelint CSS budget', () => {
	test( 'clean modern CSS passes', async () => {
		const result = await lint(
			'.demo {\n\tcolor: red;\n\n\t&:hover {\n\t\tcolor: blue;\n\t}\n}\n'
		);
		expect( result.results[ 0 ].warnings ).toEqual( [] );
	} );

	test( 'Sass-style & concatenation is banned', async () => {
		const result = await lint( '.demo {\n\t&__inner {\n\t\tcolor: red;\n\t}\n}\n' );
		const rules = result.results[ 0 ].warnings.map( ( w: { rule: string } ) => w.rule );
		expect( rules ).toContain( 'selector-nested-pattern' );
	} );

	test( 'excessive specificity breaches the (0,4,1) budget', async () => {
		const result = await lint(
			'#page .a .b .c .d span {\n\tcolor: red;\n}\n'
		);
		const rules = result.results[ 0 ].warnings.map( ( w: { rule: string } ) => w.rule );
		expect( rules ).toContain( 'selector-max-specificity' );
	} );

	test( '!important is banned', async () => {
		const result = await lint( '.demo {\n\tcolor: red !important;\n}\n' );
		const rules = result.results[ 0 ].warnings.map( ( w: { rule: string } ) => w.rule );
		expect( rules ).toContain( 'declaration-no-important' );
	} );

	test( 'nesting beyond depth 3 is banned', async () => {
		const result = await lint(
			'.a {\n\t.b {\n\t\t.c {\n\t\t\t.d {\n\t\t\t\t.e {\n\t\t\t\t\tcolor: red;\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n}\n'
		);
		const rules = result.results[ 0 ].warnings.map( ( w: { rule: string } ) => w.rule );
		expect( rules ).toContain( 'max-nesting-depth' );
	} );

	test( 'admin-chrome selectors are banned (WP 7.1 iframe editor)', async () => {
		for ( const selector of [
			'.wp-admin .demo { color: red; }',
			'body.block-editor-page .demo { color: red; }',
			'#wpadminbar .demo { color: red; }',
		] ) {
			const result = await lint( `${ selector }\n` );
			const rules = result.results[ 0 ].warnings.map( ( w: { rule: string } ) => w.rule );
			expect( rules ).toContain( 'selector-disallowed-list' );
		}
	} );

	test( 'editor-scoped styling via .editor-styles-wrapper remains allowed', async () => {
		const result = await lint(
			'.editor-styles-wrapper .demo {\n\tcolor: red;\n}\n'
		);
		expect( result.results[ 0 ].warnings ).toEqual( [] );
	} );
} );