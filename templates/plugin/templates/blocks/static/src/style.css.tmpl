/* __BLOCK_TITLE__ block — plain modern CSS. Native nesting: `&` does NOT
   concatenate; write full class names. `@custom-media` is compiled. */

@custom-media --br-mobile (max-width: 480px);

.__BLOCK_PREFIX__ {
	display: block;
	padding: 1.25rem;
	border: 1px solid #ddd;
	border-radius: 8px;
	background: #fff;

	.__BLOCK_MESSAGE_CLASS__ {
		font-weight: 600;
	}

	@media (--br-mobile) {
		padding: 0.75rem;
	}
}