/* __BLOCK_TITLE__ block — PHP-only: styling the autoRegister markup.
   Native nesting: `&` does NOT concatenate; write full class names. */

.__BLOCK_PREFIX__ {
	padding: 1.25rem;
	border: 1px solid #ddd;
	border-radius: 8px;
	background: #fff;

	.__BLOCK_MESSAGE_CLASS__ {
		font-weight: 600;
	}

	&.__BLOCK_PREFIX__--accent .__BLOCK_MESSAGE_CLASS__ {
		color: #3858e9;
	}

	&.__BLOCK_PREFIX__--emphasized {
		font-weight: 600;
		border-inline-start: 3px solid #3858e9;
	}
}