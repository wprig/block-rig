{
	"$schema": "https://raw.githubusercontent.com/stylelint/stylelint/main/docs/schema.json",
	"extends": [ "stylelint-config-standard" ],
	"rules": {
		"max-nesting-depth": 3,
		"selector-max-specificity": [ "0,4,1", { "message": "Specificity budget is (0,4,1) — no IDs, keep selectors shallow. Prefer :where() to lower weight." } ],
		"declaration-no-important": true,
		"custom-property-no-missing-var-function": true,
		"selector-nested-pattern": [ "^(?!&[\\w-])", { "message": "Sass-style `&` concatenation is banned — native CSS nesting does not concatenate. Write full class names." } ],
		"selector-disallowed-list": [ [ "/\\.wp-admin/", "/#wpadminbar/", "/\\.block-editor-page/" ], { "message": "WP 7.1 editor iframe: the canvas body carries no admin classes — these selectors match nothing when iframed. Scope to your block instead (`.editor-styles-wrapper` still wraps canvas content if you need editor-only styling)." } ],
		"selector-class-pattern": null,
		"no-descending-specificity": null
	},
	"ignoreFiles": [ "blocks/*/build/**" ]
}