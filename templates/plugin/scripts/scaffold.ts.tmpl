/**
 * block:new — scaffold a new block into blocks/.
 *
 * Usage: bun run scripts/scaffold.ts <slug> [--type static|dynamic|php] [--title "..."]
 */
import path from 'node:path';
import fs from 'node:fs';
import { loadConfig } from './lib/config';

const root = path.resolve( import.meta.dir, '..' );
const config = loadConfig( root );
const TEMPLATES = path.resolve( import.meta.dir, '..', 'templates', 'blocks' );
const SLUG_RE = /^[a-z][a-z0-9-]*$/;

const args = Bun.argv.slice( 2 );
const positional: string[] = [];
const flags: Record< string, string > = {};
for ( let i = 0; i < args.length; i++ ) {
	if ( args[ i ].startsWith( '--' ) ) {
		flags[ args[ i ].slice( 2 ) ] = args[ i + 1 ] ?? '';
		i++;
	} else {
		positional.push( args[ i ] );
	}
}

const name = positional[ 0 ];
if ( ! name || ! SLUG_RE.test( name ) ) {
	console.error(
		'Usage: bun run block:new <slug> [--type static|dynamic|php] [--title "..."] (slug must be lowercase kebab-case)'
	);
	process.exit( 1 );
}

const type = flags.type ?? 'dynamic';
const src = path.join( TEMPLATES, type );
if ( ! fs.existsSync( src ) ) {
	console.error( `Unknown block type "${ type }" (expected static | dynamic | php).` );
	process.exit( 1 );
}

const dest = path.join( root, config.paths.blocksDir, name );
if ( fs.existsSync( dest ) ) {
	console.error( `Block already exists: blocks/${ name }` );
	process.exit( 1 );
}

const titleCase = ( s: string ) =>
	s.split( '-' ).map( ( w ) => w.charAt( 0 ).toUpperCase() + w.slice( 1 ) ).join( ' ' );

const tokens: Record< string, string > = {
	SLUG: config.pluginSlug,
	FUNC: config.pluginSlug.replace( /-/g, '_' ),
	PLUGIN_NAME: config.pluginName,
	NAMESPACE: config.namespace,
	TEXT_DOMAIN: config.pluginSlug,
	VERSION: config.version,
	YEAR: String( new Date().getFullYear() ),
	BLOCK_NAME: name,
	BLOCK_TITLE: flags.title ?? titleCase( name ),
	BLOCK_PREFIX: `br-${ name }`,
	BLOCK_MESSAGE_CLASS: `br-${ name }__message`,
};

fs.mkdirSync( dest, { recursive: true } );

let count = 0;
async function copyDir( from: string, to: string ): Promise< void > {
	for ( const entry of fs.readdirSync( from, { withFileTypes: true } ) ) {
		const s = path.join( from, entry.name );
		const d = path.join( to, entry.name.replace( /\.tmpl$/, '' ) );
		if ( entry.isDirectory() ) {
			fs.mkdirSync( d, { recursive: true } );
			await copyDir( s, d );
		} else {
			const text = await Bun.file( s ).text();
			await Bun.write( d, text.replace( /__([A-Z][A-Z_]*?)__/g, ( m, key: string ) => tokens[ key ] ?? m ) );
			count++;
		}
	}
}

await copyDir( src, dest );

console.log( `✔ Scaffolded ${ type } block: blocks/${ name }` );
console.log( 'Next: bun run build' );