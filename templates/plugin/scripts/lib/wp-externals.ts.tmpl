/**
 * Bun plugin that remaps `@wordpress/*`, `react`, `react-dom` and the
 * automatic JSX runtime to the `window.wp.*` globals WordPress enqueues,
 * so nothing WP-provided is ever bundled.
 */
const WP_GLOBALS: Record< string, string > = {
	react: 'window.React',
	'react-dom': 'window.ReactDOM',
};

export function wpGlobalFor( pkg: string ): string | null {
	if ( WP_GLOBALS[ pkg ] ) {
		return WP_GLOBALS[ pkg ];
	}
	if ( pkg.startsWith( '@wordpress/' ) ) {
		const slug = pkg.replace( '@wordpress/', '' ).replace(
			/-([a-z])/g,
			( _, c: string ) => c.toUpperCase()
		);
		return `window.wp.${ slug }`;
	}
	return null;
}

export function wpExternals(): Bun.BunPlugin {
	return {
		name: 'block-rig-wp-externals',
		setup( build: Bun.PluginBuilder ) {
			build.onResolve(
				{ filter: /^(react|react-dom|react\/.*|@wordpress\/.*)$/ },
				( args ) => ( { path: args.path, namespace: 'wp-global' } )
			);
			build.onLoad( { filter: /.*/, namespace: 'wp-global' }, ( args ) => {
				if ( args.path === 'react/jsx-runtime' || args.path === 'react/jsx-dev-runtime' ) {
					// WordPress ships the JSX runtime as the vendor script
					// `react-jsx-runtime` (global ReactJSXRuntime) — its .min.js
					// production build exposes only jsx/jsxs (no jsxDEV), and
					// wp.element does NOT export jsx/jsxs at all. Map both runtime
					// module names onto globalThis.ReactJSXRuntime when present,
					// with a createElement-based jsxDEV fallback so dev builds
					// (which call jsxDEV) never crash.
					return {
						contents: [
							'module.exports = ( ( r ) => ( {',
							'  jsx: r.jsx || window.wp.element.createElement,',
							'  jsxs: r.jsxs || window.wp.element.createElement,',
							'  jsxDEV: r.jsxDEV || ( ( type, config, maybeKey ) => {',
							'    if ( config && maybeKey !== undefined ) { config = { ...config, key: maybeKey }; }',
							'    return window.wp.element.createElement( type, config );',
							'  } ),',
							'  Fragment: window.wp.element.Fragment,',
							'} ) )( window.ReactJSXRuntime || {} );',
						].join( '\n' ),
						loader: 'js',
					};
				}
				const global = wpGlobalFor( args.path );
				if ( ! global ) {
					return { contents: '', errors: [ { text: `Unhandled WP import: ${ args.path }` } ] };
				}
				return { contents: `module.exports = ${ global };`, loader: 'js' };
			} );
		},
	};
}